{
  "expo": {
    "name": "Mahjong Sensei",
    "slug": "mahjong-sensei",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.mahjongsensei",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to analyse your mahjong hand.",
        "NSPhotoLibraryUsageDescription": "We need photo library access to upload your mahjong hand."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D"
      },
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"],
      "package": "com.yourname.mahjongsensei"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Mahjong Sensei to access your photos to analyse your hand."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "mahjong-sensei"
  }
}